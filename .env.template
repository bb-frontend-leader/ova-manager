# env

# This is a template for the environment variables used in the project.
# Copy this file to .env and fill in the appropriate values.

# Base URL for the public API
VITE_PUBLIC_API_URL=your-api-url-here

# Base URL of the auth server (ova-auth-server), without a trailing slash.
# In development it defaults to http://localhost:3100 (see .env.development);
# set the real URL here before building for production.
VITE_AUTH_API_URL=your-auth-api-url-here
